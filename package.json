{
  "name": "opencode-voice",
  "version": "0.2.0",
  "description": "Voice conversation plugin for OpenCode TUI with STT (Groq), TTS (xAI), cost ledger, and sidebar panel",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/",
    "build": "bun build index.js --target=bun --outfile=dist/opencode-voice.js --external @opencode-ai/plugin --external @opencode-ai/plugin/tui --external @opentui/solid --external solid-js --external @opentui/keymap",
    "install:plugin": "bun run build && mkdir -p ~/.config/opencode/plugins && cp dist/opencode-voice.js ~/.config/opencode/plugins/opencode-voice.js"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.39",
    "@opentui/keymap": "^0.5.7",
    "@opentui/solid": "^0.5.6",
    "solid-js": "^1.9.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.14.39"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "license": "MIT"
}
