# Copy to .env and fill in the keys you need.
# Provider selection (overrides config.yaml):
#   VOICE_STT=groq|openai|local
#   VOICE_LLM=openrouter|xai|groq|openai|deepseek|local
#   VOICE_TTS=xai|openai|elevenlabs|edge|kokoro|local

# STT (音声→テキスト)
GROQ_API_KEY=gsk_xxx
# OPENAI_API_KEY=sk-xxx

# LLM (会話エンジン) - いずれか1つ
OPENROUTER_API_KEY=sk-or-xxx
# XAI_API_KEY=xai-xxx
# GROQ_API_KEY=gsk_xxx
# DEEPSEEK_API_KEY=sk-xxx

# TTS (テキスト→音声) - xaiが日本語対応で便利
XAI_API_KEY=xai-xxx
# OPENAI_API_KEY=sk-xxx
# ELEVENLABS_API_KEY=xxx
